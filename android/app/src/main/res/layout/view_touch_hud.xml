<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/hudActionBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Left: analog movement stick -->
        <org.spaceengine.port.JoystickView
            android:id="@+id/hudJoystick"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="24dp" />

        <!-- Right: action buttons, 2 rows x 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button
                android:id="@+id/btnHudFind"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_find"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudKeyboard"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_keyboard"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudGoTo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_goto"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button
                android:id="@+id/btnHudStop"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_stop"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudCenter"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_center"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudDragMode"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_mode_look"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom center: time controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnHudTimeSlow"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_slow"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_pause"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnHudTimeFast"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_hud_round"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/hud_fast"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btnToggleHud"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_hud_pill"
        android:minWidth="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/hud_toggle"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</FrameLayout>
