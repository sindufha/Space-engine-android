static int se_gl46_proc_cmp(const void *key, const void *elem) {
    const char *k = (const char *)key;
    const se_gl46_proc_def_t *e = (const se_gl46_proc_def_t *)elem;
    return strcmp(k, e->name);
}

static se_hle_fn_t se_find_gl46_typed_thunk(const char *name) {
    if (!name) return NULL;
    const se_gl46_proc_def_t *hit = (const se_gl46_proc_def_t *)bsearch(
        name, k_gl46_proc_defs,
        sizeof(k_gl46_proc_defs) / sizeof(k_gl46_proc_defs[0]),
        sizeof(k_gl46_proc_defs[0]), se_gl46_proc_cmp);
    return hit ? hit->fn : NULL;
}
